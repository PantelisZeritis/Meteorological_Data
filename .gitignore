# Αγνοούμε το virtual environment (πιάνει εκατοντάδες MB και είναι μόνο για το δικό σου PC)
venv/

# Αγνοούμε τα αρχεία καταγραφής (logs)
*.log

# Αγνοούμε τα "σκουπίδια" που δημιουργεί το Windows Subsystem for Linux (WSL)
*:Zone.Identifier

# Αν το "main" είναι μεταγλωττισμένο εκτελέσιμο, το αγνοούμε κι αυτό
main
